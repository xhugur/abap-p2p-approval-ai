projection;
strict ( 2 );
use draft;

define behavior for ZC_P2P_PO_HDR alias PurchaseOrder
{
  use create;
  use update;
  use delete;

  use action submit;
  use action approve;
  use action reject;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZC_P2P_PO_ITM alias PurchaseOrderItem
{
  use update;
  use delete;

  use association _PurchaseOrder { with draft; }
}